  "description": "Model Context Protocol (MCP) server and CLI for generating Trackmania GBX maps using LLMs and GBX.NET",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "tm-mcp": "dist/index.js",
    "tm-builder": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
